# ============================================================
# Observability Stack Environment Variables
# Copy this file to .env.observability and fill in the values
# ============================================================

# --- Cluster ---
CLUSTER_NAME=k3s-local
ENVIRONMENT=staging

# --- Alloy ---
# Comma-separated namespaces to scrape logs from
ALLOY_NAMESPACES=web-grading,observability

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin

# --- Pyroscope ---
# Endpoint for backend services to push profiles to Pyroscope server
PYROSCOPE_ENDPOINT=http://pyroscope.observability.svc.cluster.local:4100

# --- Cloudflare / Ingress ---
# Your Grafana domain (must have DNS pointing to your cluster via Cloudflare tunnel or external-dns)
GRAFANA_DOMAIN=web-dev2-grafana.vucongtuanduong.dpdns.org
GRAFANA_PROTOCOL=https
