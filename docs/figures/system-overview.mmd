            PG2[("submission-db")]
            PG3[("executor-db")]
            PG4[("result-db")]
            RUSTFS[("RustFS submission-files")]
        end

        subgraph Platform["Platform"]
            ARGO["ArgoCD GitOps"]
            OBS["Observability"]
        end
    end

    FE --> CF
    CF --> GW
    GW --> COURSE
