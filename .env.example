# =============================================================================
# Web Grading System — Environment Variables
# =============================================================================
# Copy file này thành .env và sửa cho đúng máy của bạn.
# .env đã có trong .gitignore, không lo push nhầm secret.
# =============================================================================

# ---- Traefik NodePort (khác nhau trên mỗi máy) -------------------------------
# Lấy bằng: kubectl get svc -n kube-system traefik -o jsonpath='{.spec.ports[?(@.name=="web")].nodePort}'
GATEWAY_PORT=31242

# ---- Database (PostgreSQL) ---------------------------------------------------
# Có thể dùng JDBC_URL (ưu tiên) hoặc set từng field riêng
JDBC_URL=jdbc:postgresql://localhost:5432/submission_db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=submission_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- RustFS (S3-compatible storage) ------------------------------------------
RUSTFS_ENDPOINT=http://rustfs:9000
# URL dùng để tạo presigned URL cho FE upload/download (phải truy cập được từ ngoài cluster)
RUSTFS_PUBLIC_ENDPOINT=https://web-dev1-rustfs-api.vucongtuanduong.dpdns.org
RUSTFS_ACCESS_KEY=minioadmin
RUSTFS_SECRET_KEY=minioadmin
RUSTFS_BUCKET_NAME=submission-files

# ---- Submission Service ------------------------------------------------------
PRESIGNED_URL_EXPIRY_MINUTES=15

# ---- Logging -----------------------------------------------------------------
# Applied to all services via the app-config secret (see set-log-level.sh)
APP_LOG_LEVEL=INFO

# ---- Cloudflare Tunnel -------------------------------------------------------
# Chỉ cần đổi nếu dùng domain/tunnel khác mặc định
DOMAIN=vucongtuanduong.dpdns.org
TUNNEL_NAME=web-dev1-web-grading
NAMESPACE=web-grading
# ---- Kafka (Aiven, SASL_SSL) -----------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_PATH=

# ---- Keycloak ---------------------------------------------------------------
KEYCLOAK_DB_URL=jdbc:postgresql://<host>:5432/keycloak?sslmode=require
KEYCLOAK_DB_USERNAME=<db_username>
KEYCLOAK_DB_PASSWORD=<db_password>
KEYCLOAK_ISSUER_URI=https://web-dev1-keycloak.vucongtuanduong.dpdns.org/realms/ptit-wgs
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<admin_password>

# ---- Keycloak Admin client (api-gateway dùng để đổi mật khẩu cho user) -------
# Secret của client wgs-user-service (service account có manage-users).
# BẮT BUỘC có giá trị — deploy/setup-namespace.sh sẽ fail nếu để trống.
# Lấy bằng: kubectl -n <namespace> get secret keycloak-admin-client ...
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ---- Keycloak password-verify client (gateway xác minh MK hiện tại, Phase 3) --
# Client RIÊNG confidential wgs-password-verify (Direct Access Grants ON) — gateway
# dùng nó cho ROPC xác minh currentPassword, vì Phase 3 tắt Direct Access Grants
# trên client trình duyệt web-grading-fe. Secret lấy ở Admin Console →
# Clients → wgs-password-verify → Credentials (runbook §10.2).
# CẶP phải đi cùng nhau: set 1 trong 2 → setup-namespace.sh fail (một nửa =
# invalid_client → 502 ở endpoint đổi mật khẩu). Cả 2 để trống = hành vi cũ
# (public web-grading-fe, không secret) — điền cả 2 ở runbook §10.2.
KEYCLOAK_PASSWORD_CLIENT_ID=
KEYCLOAK_PASSWORD_CLIENT_SECRET=

# ---- Valkey (rate limit cho endpoint đổi mật khẩu) ---------------------------
# URL kết nối Valkey (managed service). Để trống = tắt rate limit ở gateway
# (Keycloak brute force vẫn bảo vệ) — xem docs/design/keycloak-password-gateway-plan-2026-10-03-v1.md
# Format: rediss://default:<password>@<host>:<port>
VALKEY_URL=rediss://default:<password>@<host>:<port>

# ---- Gateway ↔ services trust secret -----------------------------------------
# api-gateway stamps this as X-Gateway-Secret on every forwarded request;
# course/result/submission reject requests that do not carry it (fail closed —
# blank means 401, never "trust everyone"). Generate once: openssl rand -hex 32
# Leave blank and deploy/setup-namespace.sh generates one and keeps it in the
# gateway-trust Secret across re-runs.
GATEWAY_TRUSTED_SECRET=
