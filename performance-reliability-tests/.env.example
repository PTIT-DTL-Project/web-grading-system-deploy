# Chỉ dùng staging được cô lập; không chạy kiểm thử gây tải/lỗi trên production.
TARGET_ENV=staging
EXPECTED_STAGING_HOST=staging.example.invalid
# Điền đúng chuỗi sau khi đã xác nhận cấu hình staging.
RUN_CONFIRM=
BASE_URL=https://staging.example.invalid
# Runner tự tạo thư mục kết quả riêng trong results/ cho mỗi lần chạy.
RUN_API_READ=true
API_PROFILE=smoke
RUN_GRADING_SMOKE=false
# Để trống thì tự bật đối soát khi RUN_GRADING_SMOKE=true; cần 3 DB URL chỉ đọc.
RUN_RECONCILIATION=
# Tác động ArgoCD self-heal có xác nhận riêng; mặc định không chạy.
RUN_SELF_HEAL_TEST=false
# Bắt buộc khi bật RUN_SELF_HEAL_TEST=true.
KUBE_CONTEXT=
KUBE_NAMESPACE=web-grading
FAULT_TEST_CONFIRM=
# Smoke/grading: one bearer token. Multi-VU profiles: TOKENS_FILE is a JSON array of distinct test tokens.
# Entries may be a token string or {"access_token": "...", "refresh_token": "..."}.
# Keycloak access tokens live ~5 minutes; include refresh_token for load/stress/spike
# and grading runs so k6 can renew the token mid-run instead of failing with 401.
ACCESS_TOKEN=
KEYCLOAK_CLIENT_ID=web-grading-fe
# Optional: override the token endpoint (default: <issuer>/protocol/openid-connect/token).
KEYCLOAK_TOKEN_URL=
ASSIGNMENT_ID=00000000-0000-4000-8000-000000000000
STUDENT_ASSIGNMENTS_PATH='/api/v1/student/assignments?page=0&size=20'
TOKENS_FILE=
ASSIGNMENT_DETAIL_PATH=/api/v1/student/assignments/{id}
STUDENT_ASSIGNMENT_RESULT_PATH=/api/v1/results/student/assignment/{id}
# k6 resolves ZIP_PATH and TOKENS_FILE relative to this script's k6/ directory.
ZIP_PATH=../fixtures/student-sample.zip
POLL_INTERVAL_MS=3000
GRADING_TIMEOUT_MS=600000
RESULT_TIMEOUT_MS=60000

# Optional: read-only psql connection strings. Prefer a read-only database role.
SUBMISSION_DB_URL=postgresql://readonly:CHANGE_ME@db.example.invalid:5432/submission_db?sslmode=require
EXECUTOR_DB_URL=postgresql://readonly:CHANGE_ME@db.example.invalid:5432/executor_db?sslmode=require
RESULT_DB_URL=postgresql://readonly:CHANGE_ME@db.example.invalid:5432/result_db?sslmode=require
